!/results/stage3_calibration/stage3d/stage3d_summary/fig*.png
!/results/stage5_final_evaluation/stage5a/fig*.png
!/results/stage5_final_evaluation/stage5b/fig*.png
!/results/stage5_final_evaluation/stage5d/fig*.png

